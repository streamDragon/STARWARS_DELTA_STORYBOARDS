{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "STARWARS_DELTA_CUTSCENE_SCRIPT_V1",
  "title": "STARWARS_DELTA Cutscene Script V1",
  "description": "Backward-compatible semantic cutscene authoring format. ChatGPT authors story, narrative identity, visible evidence, frame-relative composition, cinematic move intent, performance, continuity and legal audio handles. Unity owns CURRENT fingerprints, runtime IDs, exact V3/V5 materialization, camera bounds and final serialization.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "title", "durationSeconds", "beats"],
  "properties": {
    "schema": { "const": "STARWARS_DELTA_CUTSCENE_SCRIPT" },
    "schemaVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
    "creativeIntent": { "type": "string" },
    "cast": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "identityHandle"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "identityHandle": { "type": "string", "minLength": 1, "description": "Authoritative CURRENT Actor handle for narrative identity." },
          "presentationHandle": { "type": "string", "minLength": 1, "description": "Optional CURRENT presentation handle for portrait/body/world evidence. It never changes narrative identity." },
          "sameIdentityAs": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "displayName": { "type": "string" }
        }
      }
    },
    "beats": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/beat" } }
  },
  "$defs": {
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "type": { "enum": ["establishing", "arrival", "dialogue", "battle", "destruction", "retreat", "celebration", "threat_reveal", "launch", "evacuation", "transition", "custom"] },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "locationHandle": { "type": "string" },
        "storyClaim": { "type": "string" },
        "dramaticFunction": { "enum": ["setup", "build", "reveal", "reaction", "pursuit", "impact", "escape", "climax", "aftermath", "handoff", "release"] },
        "energy": { "enum": ["quiet", "low", "medium", "high", "peak"] },
        "cinematicMove": { "enum": ["establish_location", "hero_in_environment", "ship_flyby", "pullback_reveal", "command_screen_communication", "reaction", "pursuit", "reveal", "launch", "approach", "impact", "escape", "tactical_info", "aftermath", "handoff", "custom"] },
        "visible": { "type": "array", "items": { "$ref": "#/$defs/visibleElement" } },
        "relationships": { "type": "array", "items": { "$ref": "#/$defs/screenRelationship" } },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "dialogue": { "type": "array", "items": { "$ref": "#/$defs/dialogueLine" } },
        "audio": { "type": "array", "items": { "$ref": "#/$defs/audioCue" } },
        "camera": { "$ref": "#/$defs/camera" },
        "transition": { "$ref": "#/$defs/transition" },
        "continuity": { "$ref": "#/$defs/continuity" },
        "evidence": { "type": "string", "description": "Plain-language visible proof required from the compiled beat." }
      }
    },
    "visibleElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "handle"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "handle": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1, "default": 1 },
        "role": { "type": "string" },
        "state": { "type": "string" },
        "startState": { "type": "string" },
        "endState": { "type": "string" },
        "depth": { "enum": ["far", "background", "mid", "foreground", "ui"] },
        "saliency": { "enum": ["primary", "support", "ambient"] },
        "screenWidthFraction": { "type": "number", "exclusiveMinimum": 0, "maximum": 1.5 },
        "screenHeightFraction": { "type": "number", "exclusiveMinimum": 0, "maximum": 1.5 },
        "screenX": { "type": "number", "minimum": 0, "maximum": 1 },
        "screenY": { "type": "number", "minimum": 0, "maximum": 1 },
        "enterFrom": { "enum": ["left", "right", "top", "bottom", "center", "reveal", "none"] },
        "exitTo": { "enum": ["left", "right", "top", "bottom", "center", "hide", "destroy", "none"] },
        "travelDirection": { "enum": ["left_to_right", "right_to_left", "toward_camera", "away_from_camera", "clockwise", "counterclockwise", "none"] },
        "facing": { "enum": ["left", "right", "toward_target", "away_from_target", "camera", "none"] },
        "performanceIntent": { "type": "string", "description": "Semantic performance intent such as urgent_locomotion, fear, command, injured, relief, resolve, look_up, point or help. Unity resolves legal execution." },
        "animationIntent": { "type": "string", "description": "Semantic animation family intent such as walk, run, interact or hit. Never author raw animation IDs here." }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "subject"],
      "properties": {
        "type": { "enum": ["enter", "move", "formation", "attack", "fire", "impact", "destroy", "exit", "hide", "reveal", "react", "hold", "darken", "brighten"] },
        "subject": { "type": "string" },
        "target": { "type": "string" },
        "viaHandle": { "type": "string" },
        "effectHandle": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 },
        "motionIntent": { "enum": ["move", "flyby", "approach", "orbit", "intercept", "pass_camera", "bank_away", "pursuit", "escort", "rescue_approach", "formation_break", "landing", "takeoff", "circle_target", "escape", "convoy", "run_to_safety", "gather", "follow", "scatter", "look_up", "help", "enter_shelter"] },
        "trajectory": { "enum": ["linear", "arc", "curve", "orbit_like", "zigzag", "drift", "screen_parallax"] },
        "travelDirection": { "enum": ["left_to_right", "right_to_left", "toward_camera", "away_from_camera", "clockwise", "counterclockwise", "none"] },
        "speed": { "enum": ["slow", "medium", "fast", "burst"] },
        "performanceIntent": { "type": "string" },
        "animationIntent": { "type": "string" },
        "result": { "type": "string" }
      }
    },
    "dialogueLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speaker", "text"],
      "properties": {
        "speaker": { "type": "string" },
        "listener": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "mood": { "type": "string" },
        "expressionIntent": { "type": "string" },
        "performanceIntent": { "type": "string" },
        "delivery": { "enum": ["quiet", "normal", "urgent", "command", "reassuring", "warning"] },
        "presentation": { "enum": ["auto", "portrait", "radio", "monitor", "environment"] }
      }
    },
    "audioCue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "handle"],
      "properties": {
        "kind": { "enum": ["music", "ambience", "sfx"] },
        "handle": { "type": "string", "minLength": 1, "description": "Authoritative CURRENT Audio handle. Never infer from a filename or display name." },
        "operation": { "enum": ["play", "stop", "fade_in", "fade_out"] },
        "intent": { "type": "string" },
        "startOffsetSeconds": { "type": "number", "minimum": 0 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "loop": { "type": "boolean" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "intensity": { "enum": ["low", "medium", "high"] }
      }
    },
    "screenRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "subject", "target"],
      "properties": {
        "type": { "enum": ["left_of", "right_of", "ahead_of", "behind", "faces", "threatens", "follows", "escorts", "protects"] },
        "subject": { "type": "string" },
        "target": { "type": "string" }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "framing": { "enum": ["extreme_wide", "wide", "medium", "close", "detail"] },
        "movement": { "enum": ["hold", "push", "pull", "follow", "track", "drift", "shake", "impact_shake", "orbit", "cut"] },
        "subject": { "type": "string" },
        "direction": { "enum": ["left", "right", "up", "down", "clockwise", "counterclockwise", "toward", "away", "none"] },
        "intensity": { "enum": ["subtle", "medium", "strong"] },
        "parallax": { "enum": ["none", "subtle", "medium", "strong"] },
        "purpose": { "type": "string" }
      },
      "description": "camera.movement=orbit is a semantic 2D/2.5D orbit-like parallax move around the subject. It must compile to legal V3/V5 camera/layer motion and must never invent unsupported 3D geometry or viewpoints."
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style"],
      "properties": {
        "style": { "enum": ["cut", "crossfade", "fade_to_black", "fade_from_black"] },
        "durationSeconds": { "type": "number", "minimum": 0 }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preserveScreenDirection": { "type": "boolean" },
        "matchedEntityIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "startState": { "type": "string" },
        "endState": { "type": "string" }
      }
    }
  }
}
