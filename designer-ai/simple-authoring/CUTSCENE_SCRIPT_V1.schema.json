{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "STARWARS_DELTA_CUTSCENE_SCRIPT_V1",
  "title": "STARWARS_DELTA Cutscene Script V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "title", "durationSeconds", "beats"],
  "properties": {
    "schema": { "const": "STARWARS_DELTA_CUTSCENE_SCRIPT" },
    "schemaVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
    "creativeIntent": { "type": "string" },
    "cast": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "handle"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "handle": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string" }
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/beat" }
    }
  },
  "$defs": {
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "type": {
          "enum": [
            "establishing",
            "arrival",
            "dialogue",
            "battle",
            "destruction",
            "retreat",
            "celebration",
            "threat_reveal",
            "launch",
            "evacuation",
            "transition",
            "custom"
          ]
        },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "locationHandle": { "type": "string" },
        "storyClaim": { "type": "string" },
        "visible": {
          "type": "array",
          "items": { "$ref": "#/$defs/visibleElement" }
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        },
        "dialogue": {
          "type": "array",
          "items": { "$ref": "#/$defs/dialogueLine" }
        },
        "camera": { "$ref": "#/$defs/camera" },
        "evidence": {
          "type": "string",
          "description": "Plain-language statement of what Unity must visibly show to prove this beat happened. This is authoring/preflight evidence, not runtime behavior."
        }
      }
    },
    "visibleElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "handle"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "handle": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1, "default": 1 },
        "role": { "type": "string" },
        "state": { "type": "string" },
        "depth": { "enum": ["far", "background", "mid", "foreground", "ui"] },
        "enterFrom": { "enum": ["left", "right", "top", "bottom", "center", "reveal", "none"] },
        "exitTo": { "enum": ["left", "right", "top", "bottom", "center", "hide", "destroy", "none"] }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "subject"],
      "properties": {
        "type": {
          "enum": [
            "enter",
            "move",
            "formation",
            "attack",
            "fire",
            "impact",
            "destroy",
            "exit",
            "hide",
            "reveal",
            "react",
            "hold",
            "darken",
            "brighten"
          ]
        },
        "subject": { "type": "string" },
        "target": { "type": "string" },
        "viaHandle": { "type": "string" },
        "effectHandle": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 },
        "result": { "type": "string" }
      }
    },
    "dialogueLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speaker", "text"],
      "properties": {
        "speaker": { "type": "string" },
        "listener": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "mood": { "type": "string" }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "framing": { "enum": ["extreme_wide", "wide", "medium", "close", "detail"] },
        "movement": { "enum": ["hold", "push", "pull", "follow", "track", "cut"] },
        "subject": { "type": "string" },
        "purpose": { "type": "string" }
      }
    }
  }
}
