{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "STARWARS_DELTA_CUTSCENE_VALIDATION_CURRENT",
  "title": "STARWARS_DELTA Cutscene Validation CURRENT",
  "description": "Published authoring-facing projection of Unity Cutscene validation. Unity remains the final validator.",
  "type": "object",
  "required": ["schema","schemaVersion","status","publishTransactionId","requiredCurrent","rules"],
  "properties": {
    "schema": { "const": "STARWARS_DELTA_CUTSCENE_VALIDATION_CURRENT" },
    "schemaVersion": { "const": 1 },
    "status": { "const": "CURRENT_VERIFIED_CUTSCENE_VALIDATION" },
    "publishTransactionId": { "type": "string", "minLength": 1 },
    "catalogRevision": { "type": ["string","number"] },
    "revision": { "type": "string" },
    "generatedUtc": { "type": "string" },
    "requiredCurrent": {
      "type": "object",
      "required": ["catalogRevision","contractRevision","schemaHash","snapshotContentHash","authoringRuleRegistryRevision"],
      "properties": {
        "catalogRevision": { "type": ["string","number"] },
        "contractRevision": { "type": "string", "minLength": 1 },
        "schemaHash": { "type": "string", "minLength": 1 },
        "snapshotContentHash": { "type": "string", "minLength": 1 },
        "authoringRuleRegistryRevision": { "type": "string", "minLength": 1 }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["severity","blocksCompilation","authoringRequirement","description"],
        "anyOf": [
          { "required": ["ruleId"] },
          { "required": ["diagnosticCode"] },
          { "required": ["code"] }
        ],
        "properties": {
          "ruleId": { "type": "string", "minLength": 1 },
          "diagnosticCode": { "type": "string", "minLength": 1 },
          "code": { "type": "string", "minLength": 1 },
          "category": { "type": "string" },
          "severity": { "type": "string", "minLength": 1 },
          "blocksCompilation": { "type": "boolean" },
          "authoringRequirement": { "enum": ["MUST_AUTHOR","MAY_OMIT_BACKEND_DEFAULT","OPTIONAL","NOT_AUTHORED_IN_SIMPLE_V1"] },
          "backendOwner": { "type": ["string","null"] },
          "description": { "type": "string", "minLength": 1 },
          "defaultPolicy": { "type": "string" },
          "normalizationPolicy": { "type": "string" },
          "autoRepairPolicy": { "type": "string" },
          "validationPolicy": { "type": "string" },
          "chatInstruction": { "type": "string" },
          "studioMessage": { "type": "string" },
          "introducedRevision": { "type": ["integer","null"] },
          "deprecatedRevision": { "type": ["integer","null"] },
          "regressionTestId": { "type": ["string","null"] },
          "diagnosticAliases": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
