{
  "schema": "STARWARS_DELTA_V4_MOVE_RECIPES",
  "schemaVersion": 1,
  "status": "SOURCE_GUIDANCE_NOT_PUBLISHED",
  "purpose": "Authoring-side cinematic choreography recipes that expand into existing CUTSCENE_SCRIPT_V1 actions. This file does not add runtime enums, does not change Unity execution, and recipe names are never serialized into CUTSCENE_SCRIPT_V1.",
  "serializationRule": "Choose a recipe during planning, then expand it into ordinary visible/actions/camera/continuity fields that are already legal in CUTSCENE_SCRIPT_V1. Never emit a recipeName field into production JSON.",
  "runtimeTruth": {
    "existingV5ActionForms": ["Move", "Enter", "Exit", "Formation", "Hold", "Orbit", "VisualWeaponAction", "Deactivate"],
    "actorOrbitV1": "fixed_center_only",
    "movingTargetOrbitSupported": false,
    "perFrameTargetRelativePursuitGuaranteed": false,
    "perFrameTargetRelativeEscortGuaranteed": false,
    "perFrameTargetRelativeInterceptGuaranteed": false,
    "semanticSpeeds": ["slow", "medium", "fast", "burst"]
  },
  "globalRules": [
    "Use only exact CURRENT handles and inspected visual evidence.",
    "A recipe is a choreography pattern, not a new runtime primitive.",
    "Expand recipes only into action types and motionIntent values already accepted by CUTSCENE_SCRIPT_V1.",
    "Do not imply moving-target tracking when the current Timeline writer only performs resolved movement.",
    "For actor Orbit, the center must remain stationary throughout the Orbit interval.",
    "For count-expanded actors, apply the same source recipe deterministically to every generated member unless the recipe explicitly assigns staggered members.",
    "Do not count-expand a precomposed fleet/group visual as if it were one ship.",
    "Prefer 2D screen choreography, depth, timing and cuts over fake 3D geometry."
  ],
  "recipes": [
    {
      "id": "CROSSING_FLYBY",
      "category": "pass",
      "intent": "One or more ships cross the frame cleanly and leave.",
      "bestFor": ["arrival", "scale", "transition", "victory"],
      "expansion": [
        {"type": "enter", "motionIntent": "flyby", "speed": "medium"},
        {"type": "move", "motionIntent": "pass_camera", "trajectory": "linear", "speed": "fast"},
        {"type": "exit", "motionIntent": "flyby", "speed": "fast"}
      ],
      "camera": {"preferred": ["hold", "track"], "note": "Track only when the subject is a legal physical Actor target."}
    },
    {
      "id": "HERO_SWEEP",
      "category": "pass",
      "intent": "Hero ship sweeps through the composition while support craft remain secondary.",
      "bestFor": ["hero entrance", "battle transition", "rescue"],
      "expansion": [
        {"type": "enter", "motionIntent": "flyby", "speed": "fast"},
        {"type": "move", "motionIntent": "pass_camera", "trajectory": "arc", "speed": "fast"},
        {"type": "move", "motionIntent": "bank_away", "trajectory": "curve", "speed": "fast"},
        {"type": "exit", "motionIntent": "escape", "speed": "fast"}
      ]
    },
    {
      "id": "ATTACK_RUN",
      "category": "combat",
      "intent": "Attacker commits to one readable firing pass and exits the danger lane.",
      "bestFor": ["fighter attack", "boss strike", "intercept"],
      "expansion": [
        {"type": "move", "motionIntent": "approach", "trajectory": "linear", "speed": "fast"},
        {"type": "fire", "speed": "burst"},
        {"type": "move", "motionIntent": "pass_camera", "trajectory": "linear", "speed": "fast"},
        {"type": "move", "motionIntent": "bank_away", "trajectory": "curve", "speed": "fast"}
      ],
      "constraint": "Fire is visual staging; do not imply gameplay projectile simulation."
    },
    {
      "id": "BOOM_AND_BREAK",
      "category": "combat",
      "intent": "Impact is followed by an immediate formation break that clears the explosion.",
      "bestFor": ["boss hit", "convoy ambush", "capital ship damage"],
      "expansion": [
        {"type": "attack", "speed": "burst"},
        {"type": "impact"},
        {"type": "formation", "motionIntent": "formation_break", "speed": "fast"},
        {"type": "move", "motionIntent": "bank_away", "trajectory": "curve", "speed": "fast"}
      ]
    },
    {
      "id": "DOUBLE_INTERCEPT",
      "category": "combat",
      "intent": "Two or more actors converge on a threatened lane from different screen sides.",
      "bestFor": ["defense", "escort rescue", "boss approach"],
      "expansion": [
        {"type": "formation", "motionIntent": "formation_break", "speed": "medium"},
        {"type": "move", "motionIntent": "intercept", "trajectory": "linear", "speed": "fast"},
        {"type": "hold", "speed": "slow"}
      ],
      "note": "Intercept is resolved choreography, not guaranteed per-frame target tracking."
    },
    {
      "id": "FLANK_LEFT",
      "category": "combat",
      "intent": "Support craft peel to the left lane while the principal subject stays readable.",
      "expansion": [
        {"type": "formation", "motionIntent": "formation_break", "speed": "medium"},
        {"type": "move", "motionIntent": "intercept", "trajectory": "arc", "travelDirection": "right_to_left", "speed": "fast"}
      ]
    },
    {
      "id": "FLANK_RIGHT",
      "category": "combat",
      "intent": "Support craft peel to the right lane while the principal subject stays readable.",
      "expansion": [
        {"type": "formation", "motionIntent": "formation_break", "speed": "medium"},
        {"type": "move", "motionIntent": "intercept", "trajectory": "arc", "travelDirection": "left_to_right", "speed": "fast"}
      ]
    },
    {
      "id": "PURSUIT_LANES",
      "category": "chase",
      "intent": "Chasers occupy staggered screen/depth lanes while all move in the same broad direction.",
      "bestFor": ["pursuit", "escape", "convoy threat"],
      "expansion": [
        {"type": "formation", "motionIntent": "escort", "speed": "medium"},
        {"type": "move", "motionIntent": "pursuit", "trajectory": "linear", "speed": "fast"}
      ],
      "note": "Use screen/depth staggering. Do not claim dynamic homing to a moving target."
    },
    {
      "id": "CHASE_THROUGH_FRAME",
      "category": "chase",
      "intent": "Target crosses first; pursuers enter shortly after on the same screen direction.",
      "expansion": [
        {"type": "move", "motionIntent": "escape", "trajectory": "linear", "speed": "fast"},
        {"type": "enter", "motionIntent": "pursuit", "speed": "fast"},
        {"type": "move", "motionIntent": "pursuit", "trajectory": "linear", "speed": "fast"}
      ],
      "continuity": "Preserve screen direction for target and pursuers."
    },
    {
      "id": "ESCORT_COLUMN",
      "category": "formation",
      "intent": "Principal craft leads while escorts occupy readable support lanes.",
      "bestFor": ["convoy", "arrival", "escape"],
      "expansion": [
        {"type": "formation", "motionIntent": "escort", "speed": "medium"},
        {"type": "move", "motionIntent": "convoy", "trajectory": "linear", "speed": "medium"}
      ]
    },
    {
      "id": "ESCORT_PEEL_OFF",
      "category": "formation",
      "intent": "Escorts hold formation, then peel away in a readable departure.",
      "expansion": [
        {"type": "formation", "motionIntent": "escort", "speed": "medium"},
        {"type": "formation", "motionIntent": "formation_break", "speed": "fast"},
        {"type": "move", "motionIntent": "bank_away", "trajectory": "curve", "speed": "fast"},
        {"type": "exit", "motionIntent": "escape", "speed": "fast"}
      ]
    },
    {
      "id": "FORMATION_SPREAD",
      "category": "formation",
      "intent": "A tight group expands into separated readable lanes.",
      "expansion": [
        {"type": "formation", "motionIntent": "formation_break", "speed": "medium"},
        {"type": "hold", "speed": "slow"}
      ],
      "note": "Spacing comes from existing spatial staging, not raw authored world coordinates."
    },
    {
      "id": "FORMATION_CONVERGE",
      "category": "formation",
      "intent": "Separated craft visually converge toward one battle/arrival lane.",
      "expansion": [
        {"type": "move", "motionIntent": "approach", "trajectory": "linear", "speed": "medium"},
        {"type": "formation", "motionIntent": "escort", "speed": "medium"},
        {"type": "hold", "speed": "slow"}
      ]
    },
    {
      "id": "BANK_AND_EXIT",
      "category": "retreat",
      "intent": "A readable curved retreat rather than an abrupt disappearance.",
      "expansion": [
        {"type": "move", "motionIntent": "bank_away", "trajectory": "curve", "speed": "fast"},
        {"type": "exit", "motionIntent": "escape", "speed": "fast"}
      ]
    },
    {
      "id": "FORMATION_RETREAT",
      "category": "retreat",
      "intent": "A group breaks formation, then exits through distinct lanes.",
      "expansion": [
        {"type": "formation", "motionIntent": "formation_break", "speed": "fast"},
        {"type": "move", "motionIntent": "escape", "trajectory": "linear", "speed": "fast"},
        {"type": "exit", "motionIntent": "escape", "speed": "fast"}
      ]
    },
    {
      "id": "DAMAGED_WITHDRAWAL",
      "category": "retreat",
      "intent": "Damaged actor survives the hit, slows briefly, then withdraws.",
      "expansion": [
        {"type": "react", "speed": "slow"},
        {"type": "hold", "speed": "slow"},
        {"type": "move", "motionIntent": "escape", "trajectory": "drift", "speed": "slow"},
        {"type": "exit", "motionIntent": "escape", "speed": "medium"}
      ]
    },
    {
      "id": "TAKEOFF_ESCORT",
      "category": "launch",
      "intent": "Primary ship rises first; escorts join as the shot opens into travel.",
      "expansion": [
        {"type": "move", "motionIntent": "takeoff", "trajectory": "linear", "speed": "medium"},
        {"type": "formation", "motionIntent": "escort", "speed": "medium"},
        {"type": "move", "motionIntent": "escape", "trajectory": "linear", "speed": "medium"}
      ]
    },
    {
      "id": "LAUNCH_WAVE",
      "category": "launch",
      "intent": "Multiple craft depart in a readable stagger rather than appearing simultaneously.",
      "expansion": [
        {"type": "enter", "motionIntent": "takeoff", "speed": "medium"},
        {"type": "move", "motionIntent": "takeoff", "trajectory": "linear", "speed": "medium"},
        {"type": "formation", "motionIntent": "escort", "speed": "medium"}
      ],
      "countRule": "Use deterministic member staggering if supported by current timing fields; otherwise stage across adjacent beats."
    },
    {
      "id": "LANDING_APPROACH",
      "category": "landing",
      "intent": "Approach establishes the destination before a separate landing motion.",
      "expansion": [
        {"type": "move", "motionIntent": "approach", "trajectory": "linear", "speed": "medium"},
        {"type": "move", "motionIntent": "landing", "trajectory": "linear", "speed": "slow"},
        {"type": "hold", "speed": "slow"}
      ]
    },
    {
      "id": "LAND_THEN_GUARD_ORBIT",
      "category": "landing",
      "intent": "Primary ship completes landing; guards orbit only after the center is stationary.",
      "expansion": [
        {"type": "move", "motionIntent": "landing", "trajectory": "linear", "speed": "slow"},
        {"type": "hold", "speed": "slow"},
        {"type": "move", "motionIntent": "orbit", "trajectory": "orbit_like", "speed": "slow"}
      ],
      "constraint": "The Orbit interval must begin only after the landing center has stopped moving. Use adjacent beats when overlap cannot be represented safely."
    },
    {
      "id": "STATIC_CENTER_ORBIT_REVEAL",
      "category": "orbit",
      "intent": "A stationary center is revealed while support actors orbit it.",
      "expansion": [
        {"type": "hold", "speed": "slow"},
        {"type": "move", "motionIntent": "orbit", "trajectory": "orbit_like", "speed": "slow"}
      ],
      "camera": {"preferred": ["pull", "hold"], "note": "Reveal can be camera-driven while the actor center remains stationary."},
      "constraint": "Center actor has no overlapping moving action."
    },
    {
      "id": "ORBIT_THEN_BREAK",
      "category": "orbit",
      "intent": "Guards complete a fixed-center orbit, then break formation and leave.",
      "expansion": [
        {"type": "move", "motionIntent": "orbit", "trajectory": "orbit_like", "speed": "slow"},
        {"type": "formation", "motionIntent": "formation_break", "speed": "fast"},
        {"type": "move", "motionIntent": "bank_away", "trajectory": "curve", "speed": "fast"}
      ],
      "constraint": "Center remains stationary for the Orbit interval."
    },
    {
      "id": "RESCUE_PASS",
      "category": "rescue",
      "intent": "Rescue actor approaches the threatened subject, crosses the danger lane, then escorts it away.",
      "expansion": [
        {"type": "move", "motionIntent": "rescue_approach", "trajectory": "linear", "speed": "fast"},
        {"type": "hold", "speed": "slow"},
        {"type": "formation", "motionIntent": "escort", "speed": "medium"},
        {"type": "move", "motionIntent": "escape", "trajectory": "linear", "speed": "fast"}
      ]
    },
    {
      "id": "CONVOY_ESCAPE",
      "category": "rescue",
      "intent": "Convoy exits in one preserved screen direction while escorts cover it.",
      "expansion": [
        {"type": "formation", "motionIntent": "escort", "speed": "medium"},
        {"type": "move", "motionIntent": "convoy", "trajectory": "linear", "speed": "medium"},
        {"type": "move", "motionIntent": "escape", "trajectory": "linear", "speed": "fast"}
      ],
      "continuity": "Preserve screen direction across adjacent beats."
    },
    {
      "id": "THREAT_REVEAL_PASS",
      "category": "reveal",
      "intent": "Camera reveals a stationary threat while smaller craft cross foreground/midground for scale.",
      "expansion": [
        {"type": "hold", "speed": "slow"},
        {"type": "enter", "motionIntent": "flyby", "speed": "medium"},
        {"type": "move", "motionIntent": "pass_camera", "trajectory": "linear", "speed": "medium"}
      ],
      "camera": {"preferred": ["pull", "hold"]}
    },
    {
      "id": "VICTORY_FLYBY",
      "category": "release",
      "intent": "A celebratory clean pass with a later formation break rather than combat motion.",
      "expansion": [
        {"type": "enter", "motionIntent": "flyby", "speed": "medium"},
        {"type": "move", "motionIntent": "pass_camera", "trajectory": "linear", "speed": "medium"},
        {"type": "formation", "motionIntent": "formation_break", "speed": "medium"},
        {"type": "exit", "motionIntent": "flyby", "speed": "medium"}
      ]
    },
    {
      "id": "QUIET_DRIFT_OUT",
      "category": "release",
      "intent": "End a sequence with slow controlled motion rather than a hard disappearance.",
      "expansion": [
        {"type": "move", "motionIntent": "escape", "trajectory": "drift", "speed": "slow"},
        {"type": "exit", "motionIntent": "escape", "speed": "slow"}
      ],
      "camera": {"preferred": ["hold", "drift"]}
    },
    {
      "id": "SCREEN_CROSS_REVEAL",
      "category": "composition",
      "intent": "Foreground actor crosses frame to expose a stationary subject/background behind it.",
      "expansion": [
        {"type": "enter", "motionIntent": "pass_camera", "speed": "medium"},
        {"type": "move", "motionIntent": "pass_camera", "trajectory": "linear", "speed": "medium"},
        {"type": "exit", "motionIntent": "pass_camera", "speed": "medium"}
      ],
      "camera": {"preferred": ["hold"], "note": "The reveal comes from actor occlusion clearing, not fake 3D camera rotation."}
    },
    {
      "id": "CROSS_TRAFFIC",
      "category": "composition",
      "intent": "Two independent lanes cross at different depths to create controlled activity without implying tracking.",
      "expansion": [
        {"type": "move", "motionIntent": "flyby", "trajectory": "linear", "speed": "medium"},
        {"type": "move", "motionIntent": "pass_camera", "trajectory": "linear", "speed": "fast"}
      ],
      "constraint": "Use different screen/depth lanes; avoid unreadable overlap."
    },
    {
      "id": "HOLD_THEN_BURST",
      "category": "rhythm",
      "intent": "Actor holds for anticipation, then performs one fast move or attack beat.",
      "expansion": [
        {"type": "hold", "speed": "slow"},
        {"type": "move", "motionIntent": "approach", "trajectory": "linear", "speed": "burst"}
      ]
    },
    {
      "id": "ARRIVE_SETTLE_HOLD",
      "category": "rhythm",
      "intent": "Arrival has motion, then visibly settles so the next dialogue/reveal shot is readable.",
      "expansion": [
        {"type": "enter", "motionIntent": "approach", "speed": "medium"},
        {"type": "move", "motionIntent": "approach", "trajectory": "linear", "speed": "slow"},
        {"type": "hold", "speed": "slow"}
      ]
    }
  ]
}
